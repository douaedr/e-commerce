{% extends 'base.html.twig' %}
{% block title %}Catégories{% endblock %}
{% block body %}
<div class="container my-5">
    <h1 class="mb-4">Toutes les Catégories</h1>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        {% for category in categories %}
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <span class="badge bg-primary mb-2">{{ category.products|length }} produits</span>
                    <h4 class="card-title">{{ category.name }}</h4>
                    <p class="card-text text-muted">{{ category.description }}</p>
                    <a href="{{ path('app_category_products', {id: category.id}) }}" class="btn btn-outline-primary">Voir</a>
                </div>
            </div>
        </div>
        {% else %}
        <p class="text-muted">Aucune catégorie.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}